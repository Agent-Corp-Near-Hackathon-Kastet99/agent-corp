{
  "name": "agent-corp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "setup:testnet": "pnpm --filter @agentcorp/server run setup",
    "constraints": "pnpm --filter @agentcorp/server run constraints",
    "demo": "pnpm --filter @agentcorp/server run demo",
    "start": "pnpm --filter @agentcorp/server run start",
    "test": "pnpm -r test",
    "test:contract": "cd contract && cargo test --lib",
    "typecheck": "pnpm -r typecheck",
    "growth": "pnpm --filter @agentcorp/server run growth"
  },
  "devDependencies": {
    "@agentcorp/worker": "workspace:*",
    "@types/node": "^24.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
