# Copy to .env.growth (gitignored). Never commit real values. Prefer the `secrets` skill over pasting keys anywhere.
# Dry-run is the DEFAULT. Nothing leaves this machine until you set GROWTH_DRY_RUN=off.
GROWTH_DRY_RUN=on
GROWTH_EXPENSE_WRITES=off
# Testnet reimbursement recipient and explicit demo conversion; not a market exchange rate.
GROWTH_EXPENSE_PAYEE=
GROWTH_EXPENSE_USD_PER_NEAR=5
GROWTH_BOARD_WRITES=off          # on = let the growth agent create/finalize Board proposals on the TESTNET contract even in dry-run
GROWTH_ADMIN_TOKEN=            # optional; random token is generated and printed at startup if empty

ANTHROPIC_API_KEY=
GROWTH_MODEL=claude-sonnet-5-5
GROWTH_LLM_IN_PER_MTOK=3       # budget ESTIMATES (USD per million tokens), not read from billing
GROWTH_LLM_OUT_PER_MTOK=15

POSTIZ_API_KEY=
POSTIZ_BASE_URL=               # self-host only, e.g. https://postiz.example.com/api/public/v1
POSTIZ_X_INTEGRATION_ID=       # optional pin; otherwise discovered from /integrations
POSTIZ_LINKEDIN_INTEGRATION_ID=

BLUESKY_HANDLE=corp.bsky.social
BLUESKY_APP_PASSWORD=          # an app password, never the account password
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=              # OUR channel/chat only
DISCORD_WEBHOOK_URL=           # OUR server only

FAL_KEY=
GROWTH_FAL_MODEL=fal-ai/flux/schnell
GROWTH_FAL_IMAGE_USD=0.05      # per-image ESTIMATE for the budget gate
EXA_API_KEY=

POSTHOG_KEY=                   # project (public) key, for capture
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=      # for funnel reads
POSTHOG_PROJECT_ID=

RESEND_API_KEY=
RESEND_FROM=                   # a verified sender; opt-in recipients only (Resend AUP forbids cold email)
INSTANTLY_API_KEY=             # campaigns are created PAUSED and never launched by this harness

GROWTH_CLIP_PATH=              # optional recorded gameplay clip (mp4/webm); cut with local ffmpeg
GROWTH_AUTO_HOURS=             # optional: >0 enables the auto loop (measure when due, else next cycle)
